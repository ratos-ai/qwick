# Copy this file to .env and fill in your own values

API_HOST="127.0.0.1"
API_PORT=8000

DB_URL="postgresql+asyncpg://user:password@localhost:5432/mydb"
DB_ECHO=False
DB_USER="admin"
DB_PASSWORD="passwd"
DB_NAME="testdb"

AUTH__ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH__REFRESH_TOKEN_EXPIRE_DAYS=90
AUTH__ALGORITHM="RS256"
AUTH__REFRESH_TOKEN_COOKIE_SECURE=False
AUTH__PRIVATE_KEY_PATH="certs/private-key.pem"
AUTH__PUBLIC_KEY_PATH="certs/public-key.pem"